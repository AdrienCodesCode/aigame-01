{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "WIDE_EYE_LINUX_COMPILER_PROFILE": "clang-18",
        "WIDE_EYE_WARNINGS_AS_ERRORS": true
      }
    },
    {
      "name": "dev",
      "displayName": "Development",
      "description": "Debug build with strict project warnings.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "dev-sanitized",
      "displayName": "Sanitized development",
      "description": "Debug build with strict project warnings and supported sanitizers.",
      "inherits": "dev",
      "cacheVariables": {
        "WIDE_EYE_ENABLE_SANITIZERS": true
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized release build with strict project warnings (Clang 18 on Linux, MSVC on Windows).",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-gcc",
      "displayName": "Release (GCC portability)",
      "description": "Optimized Linux portability build pinned to GCC 13.",
      "inherits": "release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "WIDE_EYE_LINUX_COMPILER_PROFILE": "gcc-13"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "dev-sanitized",
      "configurePreset": "dev-sanitized"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "release-gcc",
      "configurePreset": "release-gcc"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "dev-sanitized",
      "configurePreset": "dev-sanitized",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "release-gcc",
      "configurePreset": "release-gcc",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    }
  ]
}
